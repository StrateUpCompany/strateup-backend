{
    "name": "strateup-backend",
    "version": "0.1.0",
    "description": "Backend Fastify + TypeScript + Prisma + Supabase",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write .",
        "test": "jest",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@fastify/cors": "^11.0.1",
        "@fastify/swagger": "^9.5.1",
        "@fastify/swagger-ui": "^5.2.3",
        "@prisma/client": "^5.0.0",
        "dotenv": "^16.0.0",
        "fastify": "^5.4.0",
        "jsonwebtoken": "^9.0.2"
    },
    "devDependencies": {
        "@types/jest": "^29.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-import": "^2.0.0",
        "jest": "^29.0.0",
        "prettier": "^3.0.0",
        "prisma": "^5.0.0",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.0.0"
    }
}
